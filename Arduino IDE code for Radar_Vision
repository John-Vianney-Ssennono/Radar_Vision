/*
  Proximity Alert System: Ultrasonic Sensor + Buzzer + LED Sync
  - Measures distance using a 3-pin ultrasonic sensor on Pin 7.
  - Syncs both the Buzzer (Pin 11) and LED (Pin 13) to blink/beep faster as objects get closer.
  - Uses non-blocking timing (millis) for continuous measurement without freezing.
*/

// --- HARDWARE PINS ---
const int SENSOR_PIN = 7;   // 3-pin Ultrasonic SIG pin
const int BUZZER_PIN = 11;  // Piezo Buzzer positive pin
const int LED_PIN    = 13;  // Sync LED pin

// --- THRESHOLDS & TIMING ---
const int MAX_DISTANCE = 100; // Activation distance threshold (cm)
const int MIN_DISTANCE = 5;   // Minimum distance limit (cm)

unsigned long previousMillis = 0;
bool alertState = LOW;

void setup() {
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(LED_PIN, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  // 1. Measure Distance (3-Pin Ultrasonic Sensor)
  pinMode(SENSOR_PIN, OUTPUT);
  digitalWrite(SENSOR_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(SENSOR_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(SENSOR_PIN, LOW);

  pinMode(SENSOR_PIN, INPUT);
  long duration = pulseIn(SENSOR_PIN, HIGH);
  int distance = duration * 0.034 / 2; // Convert to cm

  Serial.print("Distance: ");
  Serial.print(distance);
  Serial.println(" cm");

  // 2. Synchronized Alert Logic (Buzzer + LED)
  if (distance > 0 && distance <= MAX_DISTANCE) {
    // Calculate alert interval (50ms = rapid pulse, 600ms = slow pulse)
    int interval = map(distance, MIN_DISTANCE, MAX_DISTANCE, 50, 600);

    // Toggle Buzzer & LED using non-blocking timer
    if (millis() - previousMillis >= interval) {
      previousMillis = millis();
      alertState = !alertState;

      digitalWrite(LED_PIN, alertState);
      if (alertState) {
        tone(BUZZER_PIN, 1000); // Buzzer ON (1000 Hz)
      } else {
        noTone(BUZZER_PIN);     // Buzzer OFF
      }
    }
  } else {
    // Object out of range: Turn off both Buzzer and LED
    noTone(BUZZER_PIN);
    digitalWrite(LED_PIN, LOW);
    alertState = LOW;
  }

  delay(30); // Short delay for sensor stability
}
